dplyr::select(code_region, name_region, geom) %>%
mutate(name_region = recode(name_region,
"Norte"         = "Norte",
"Nordeste"      = "Nordeste",
"Sudeste"       = "Sudeste",
"Sul"           = "Sul",
"Centro Oeste"  = "Centro-Oeste"
))
