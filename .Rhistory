left_join(
taxa_regiao %>%
pivot_longer(-Regiao, names_to = "Ano", values_to = "taxa") %>%
mutate(taxa = round(taxa, 2)) %>%
pivot_wider(names_from = Ano, values_from = taxa,
names_sort = TRUE, names_prefix = "tx_"),
by = "Regiao"
) %>%
arrange(Regiao) %>%
select(Regiao,
ob_2020, tx_2020,
ob_2021, tx_2021,
ob_2022, tx_2022,
ob_2023, tx_2023)
xtable(tab_regiao)
