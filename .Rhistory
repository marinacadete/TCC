# Item 5(a) – Gráficos \u0078\u0304 (x-barra) e R
# Dados do enunciado: n = 7; m = 35; sum(x\u0304_i) = 7805; sum(R_i) = 1200
# (Montgomery, Cap. 6 – lista 2)
# Parâmetros
n <- 7
m <- 35
sum_xbar <- 7805
sum_R <- 1200
# Estimativas
xbarbar <- sum_xbar / m      # média das médias
Rbar    <- sum_R / m         # média dos alcances
# Constantes para n = 7
A2 <- 0.419
D3 <- 0.076
D4 <- 1.924
# Limites de controle
UCL_x <- xbarbar + A2 * Rbar
LCL_x <- xbarbar - A2 * Rbar
UCL_R <- D4 * Rbar
LCL_R <- D3 * Rbar
# Índices das amostras
i <- 1:m
# Vetores dos pontos (substitua por seus dados, se tiver os 35 valores individuais)
# Ex.: xbar_i <- c( ... 35 valores ... )
#      R_i    <- c( ... 35 valores ... )
xbar_i <- rep(NA_real_, m)  # sem dados individuais, não plota pontos
R_i    <- rep(NA_real_, m)
op <- par(mfrow = c(2,1), mar = c(4,4,2,6), xaxs = "i", yaxs = "i")
## Gráfico x-barra
plot(i, xbar_i, type = "b", pch = 19,
ylim = c(min(LCL_x, xbarbar) * 0.98, max(UCL_x, xbarbar) * 1.02),
xlab = "Amostra", ylab = expression(bar(X)),
main = expression("Gr\u00E1fico " * bar(X)))
abline(h = xbarbar, lty = 2, lwd = 2)
abline(h = UCL_x,  col = "red", lty = 2, lwd = 2)
abline(h = LCL_x,  col = "red", lty = 2, lwd = 2)
# Rótulos fora da área do gráfico (margem direita)
usr <- par("usr"); x_right <- usr[2]
text(x_right, UCL_x,  labels = sprintf("LSC = %.3f", UCL_x),  pos = 4, xpd = NA)
text(x_right, xbarbar,labels = sprintf("LC  = %.3f", xbarbar),pos = 4, xpd = NA)
text(x_right, LCL_x,  labels = sprintf("LIC = %.3f", LCL_x),  pos = 4, xpd = NA)
## Gráfico R
plot(i, R_i, type = "b", pch = 19,
ylim = c(0, max(UCL_R, Rbar) * 1.05),
xlab = "Amostra", ylab = "R",
main = "Gr\u00E1fico R")
abline(h = Rbar, lty = 2, lwd = 2)
abline(h = UCL_R, col = "red", lty = 2, lwd = 2)
abline(h = LCL_R, col = "red", lty = 2, lwd = 2)
usr <- par("usr"); x_right <- usr[2]
text(x_right, UCL_R,  labels = sprintf("LSC = %.3f", UCL_R),  pos = 4, xpd = NA)
text(x_right, Rbar,   labels = sprintf("LC  = %.3f", Rbar),   pos = 4, xpd = NA)
text(x_right, LCL_R,  labels = sprintf("LIC = %.3f", LCL_R),  pos = 4, xpd = NA)
par(op)
# Valores numéricos
cat(sprintf("\\n\\u0078\\u0304\\u0305 = %.3f | \\u0052\\u0305 = %.3f\\n", xbarbar, Rbar))
cat(sprintf("x-barra: LIC = %.3f | LC = %.3f | LSC = %.3f\\n", LCL_x, xbarbar, UCL_x))
cat(sprintf("R:       LIC = %.3f | LC = %.3f | LSC = %.3f\\n", LCL_R, Rbar, UCL_R))
# ---------------------------------------------------------------------------- #
#                                 IDADE                                        #
# ---------------------------------------------------------------------------- #----
sim_idade <- sim_df |>
select(Ano, IDADEanos) |>
# filter(!is.na(IDADEanos)) |>
mutate(faixa5 = cut(IDADEanos,
breaks = breaks_custom,
right = FALSE,
include.lowest = TRUE,
labels = labels_custom))
setwd("~/GitHub")
setwd("~/GitHub/TCC")
source("Codigos/1-Tratamento.R")
base_regressao <- sim %>%
filter(!is.na(ESC), !is.na(ESTCIV)) %>%
group_by(Ano, munResUf, Regiao, raca_cor, fe_quinque, fe_resumida, ESC_GRUPO,
estciv_grupo, causa_categoria) %>%
summarise(obitos = n(), .groups = "drop") %>%
left_join(
dados_projecao %>%
filter(!LOCAL %in% c("Brasil", "Norte", "Nordeste", "Sudeste", "Sul", "Centro-Oeste")) %>%
group_by(munResUf = LOCAL,
fe_quinque = faixa_etaria,
Ano = as.numeric(ano)) %>%
summarise(pop = sum(pop), .groups = "drop"), by = c("munResUf", "fe_quinque", "Ano")
) %>%
left_join(
prop_RacaCor %>% filter(Local == "Brasil"),
by = c("raca_cor" = "Raça/cor", "fe_quinque" = "Faixa_etaria")) %>%
mutate(pop_raca = pop * Proporcao)
base_regressao$raca_cor     <- relevel(factor(base_regressao$raca_cor), ref = "Branca")
base_regressao$fe_resumida  <- relevel(factor(base_regressao$fe_resumida, ordered = FALSE), ref = "45 a 64 anos")
base_regressao$estciv_grupo <- relevel(factor(base_regressao$estciv_grupo), ref = "Com companheiro")
base_regressao$ESC_GRUPO    <- relevel(factor(base_regressao$ESC_GRUPO), ref = "8 anos ou mais de Estudo")
base_regressao$Regiao       <- relevel(factor(base_regressao$Regiao), ref = "Sudeste")
modelo_1 <- glm(obitos ~ factor(Ano) + raca_cor + fe_resumida + Regiao +
ESC_GRUPO + estciv_grupo + causa_categoria +
offset(log(pop_raca)),
family = poisson,
data = base_regressao)
summary(modelo_1)
dispersiontest(modelo_1)
base_2023 <- base_regressao %>%
filter(Ano == 2023)
m0_20023 <- glm(obitos ~ raca_cor + fe_resumida + Regiao +
ESC_GRUPO + estciv_grupo + causa_categoria  +
offset(log(pop_raca)),
family = poisson, data = base_2023)
summary(m0_20023)
dispersiontest(m0_20023)
