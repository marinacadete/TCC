modelo_gamlss_pois <- gamlss(obitos ~ raca_cor + Regiao + log(pop),
family=quasi(link=log, variance= "mu"), data = base_regressao)
modelo_gamlss_bn <- gamlss(obitos ~ factor(Ano) + raca_cor + Regiao + log(pop),
family = NBI, data = base_regressao_arma)
# ============================================================================ #
#                 MODELAGEM QUASI e GAMLSS                                      ----
# ============================================================================ #
source("Codigos/1-Tratamento.R")
# ---- Base para a Regressão ---------------------------------------------------
base_regressao <- sim %>%
filter(fe_resumida == "15 a 29 anos",
!is.na(ESTCIV),
#!is.na(ESC),
Ano == 2023) %>%
group_by(Ano, munResUf, Regiao, raca_cor, causa_categoria) %>%
summarise(obitos = n(), .groups = "drop") %>%
left_join(
dados_projecao %>%
filter(!LOCAL %in% c("Brasil", "Norte", "Nordeste", "Sudeste", "Sul", "Centro-Oeste")) %>%
group_by(munResUf = LOCAL,
Ano = as.numeric(ano)) %>%
summarise(pop = sum(pop), .groups = "drop"),
by = c("munResUf", "Ano"))
# ---- Categorias de Referência ------------------------------------------------
base_regressao$raca_cor <- relevel(factor(base_regressao$raca_cor), ref = "Branca")
base_regressao$Regiao   <- relevel(factor(base_regressao$Regiao), ref = "Norte")
# ============================================================================ #
#                 Modelagem 2023
# ============================================================================ #
# ---- Modelo Quasi-Poisson ----------------------------------------------------
modelo_quasi_simples <- glm(obitos ~ raca_cor + Regiao + log(pop),
family = quasipoisson, data = base_regressao)
summary(modelo_quasi_simples)
summary(modelo_quasi_simples)$dispersion
plot(modelo_quasi_simples)
family = quasi(link = log, variance = "mu"),
modelo_quasi_vero_simples <- glm(obitos ~ raca_cor + Regiao + log(pop),
family = quasi(link = log, variance = "mu"),
data = base_regressao)
summary(modelo_quasi_vero_simples)
summary(modelo_quasi_vero_simples)$dispersion
plot(modelo_quasi_vero_simples)
