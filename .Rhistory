# Ligação LOG
modelo_pois_21 <- glm(obitos ~ raca_cor + Regiao + estciv_grupo + ESC_GRUPO + log(pop),
family = poisson(link = "log"), data = base_regressao_2)
summary(modelo_pois_21)
dispersiontest(modelo_pois_21)
fit.model <- modelo_pois_21
